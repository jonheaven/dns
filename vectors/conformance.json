{
  "protocol": "dns",
  "version": "1.3",
  "vectors": [
    {
      "id": "plain-jon",
      "ok": true,
      "op": "register",
      "body": "jon.doge",
      "name": "jon.doge",
      "namespace": "doge"
    },
    {
      "id": "json-register",
      "ok": true,
      "op": "register",
      "body": "{\"p\":\"dns\",\"op\":\"register\",\"name\":\"jon.doge\",\"url\":\"https://dogecoin.dog\"}",
      "name": "jon.doge",
      "url": "https://dogecoin.dog"
    },
    {
      "id": "uppercase-normalized",
      "ok": true,
      "op": "register",
      "body": "Jon.Doge",
      "name": "jon.doge"
    },
    {
      "id": "open-namespace-eth",
      "ok": true,
      "op": "register",
      "body": "jon.eth",
      "name": "jon.eth",
      "namespace": "eth"
    },
    {
      "id": "www-allowed",
      "ok": true,
      "op": "register",
      "body": "{\"p\":\"dns\",\"op\":\"register\",\"name\":\"www.doge\"}",
      "name": "www.doge"
    },
    {
      "id": "api-allowed",
      "ok": true,
      "op": "register",
      "body": "api.doge",
      "name": "api.doge"
    },
    {
      "id": "emoji-label",
      "ok": true,
      "op": "register",
      "body": "🐕.doge",
      "name": "🐕.doge"
    },
    {
      "id": "space-rejected",
      "ok": false,
      "body": "has space.doge"
    },
    {
      "id": "slash-path-rejected",
      "ok": false,
      "body": "d.gg/rjg9wk3uu3"
    },
    {
      "id": "leading-hyphen-rejected",
      "ok": false,
      "body": "-jon.doge"
    },
    {
      "id": "fullwidth-letters-fold",
      "ok": true,
      "op": "register",
      "body": "Ｊｏｎ.doge",
      "name": "jon.doge"
    },
    {
      "id": "dogemap-carveout",
      "ok": false,
      "body": "6412814.dogemap"
    },
    {
      "id": "dogimap-open",
      "ok": true,
      "op": "register",
      "body": "1.dogimap",
      "name": "1.dogimap"
    },
    {
      "id": "speak-digit-ns",
      "ok": true,
      "op": "register",
      "body": "such.123",
      "name": "such.123"
    },
    {
      "id": "underscore-rejected",
      "ok": false,
      "body": "self.total_supply"
    },
    {
      "id": "hyphen-ok",
      "ok": true,
      "op": "register",
      "body": "doge-labs.doge",
      "name": "doge-labs.doge"
    },
    {
      "id": "config",
      "ok": true,
      "op": "config",
      "body": "{\"p\":\"dns\",\"op\":\"config\",\"name\":\"jon.doge\",\"url\":\"https://dogex.dog\"}",
      "name": "jon.doge"
    },
    {
      "id": "dns1-pipe-body-rejected",
      "ok": false,
      "carrier": "inscription-body",
      "body": "DNS1|reg|example.doge|D8mZsgKwmSQWYRPEMCcm8KzNFj1JVF5UpA",
      "reason": "Pipe codec is not label.namespace and not p:dns JSON."
    },
    {
      "id": "dns1-pipe-opreturn-rejected",
      "ok": false,
      "carrier": "op_return",
      "body": "DNS1|reg|example.doge|D8mZsgKwmSQWYRPEMCcm8KzNFj1JVF5UpA",
      "reason": "Nulldata is not an ord inscription. Explorers call this unknown embedded data."
    },
    {
      "id": "mixed-script-rejected",
      "ok": false,
      "body": "j\u043en.doge",
      "reason": "Latin plus Cyrillic in one label is a homoglyph. Reject. Do not fold onto ASCII."
    },
    {
      "id": "cyrillic-lookalike-distinct",
      "ok": true,
      "op": "register",
      "body": "\u0441\u043e\u0440\u0435\u0445.doge",
      "name": "\u0441\u043e\u0440\u0435\u0445.doge",
      "confusable": true
    },
    {
      "id": "config-records-v12",
      "ok": true,
      "op": "config",
      "body": "{\"p\":\"dns\",\"op\":\"config\",\"name\":\"jon.doge\",\"nostr\":\"abababababababababababababababababababababababababababababababab\",\"lightning\":\"satoshi@pay.doge\",\"subdomains\":\"cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd\",\"txt\":{\"note\":\"gm\"}}",
      "name": "jon.doge"
    },
    {
      "id": "json-in-opreturn-rejected",
      "ok": false,
      "carrier": "op_return",
      "body": "{\"p\":\"dns\",\"op\":\"register\",\"name\":\"jon.doge\"}",
      "reason": "JSON registers only as inscription content."
    }
  ],
  "sequences_notes": "Each sequence is applied in order. A, B are distinct owner addresses. 'h' is the block height, 'tx' the transaction index. A register ranks by its reveal (h, tx, 0) unless 'committed' is true: then it ranks by 'commit', the P2SH output its reveal spends, when that output confirmed at most W = 30 blocks earlier (spec 5.7). 'move' spends the register output to 'to' (null = an output no address can spend). A config listed with 'sameTxAsMove' rides in the transaction of the move before it. 'expect' is the name's state after the last step; 'records' {} means no records. A replay and a live indexer MUST reach the same 'expect'.",
  "sequences": [
    {
      "id": "transfer-resets-records",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 1,
          "owner": "A",
          "body": "{\"p\":\"dns\",\"op\":\"reg\",\"name\":\"jon.doge\",\"address\":\"D8mZsgKwmSQWYRPEMCcm8KzNFj1JVF5UpA\",\"content\":\"gm\"}"
        },
        {
          "op": "move",
          "h": 120,
          "to": "B"
        }
      ],
      "expect": {
        "name": "jon.doge",
        "owner": "B",
        "records": {},
        "configured": false
      },
      "reason": "Records belong to a holding (\u00a75.3). The buyer never inherits the seller's pay-to."
    },
    {
      "id": "transfer-resets-config-records",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 1,
          "owner": "A",
          "body": "jon.doge"
        },
        {
          "op": "config",
          "h": 110,
          "tx": 3,
          "owner": "A",
          "body": "{\"p\":\"dns\",\"op\":\"config\",\"name\":\"jon.doge\",\"address\":\"D8mZsgKwmSQWYRPEMCcm8KzNFj1JVF5UpA\"}"
        },
        {
          "op": "move",
          "h": 120,
          "to": "B"
        }
      ],
      "expect": {
        "name": "jon.doge",
        "owner": "B",
        "records": {},
        "configured": false
      }
    },
    {
      "id": "move-to-same-address-keeps-records",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 1,
          "owner": "A",
          "body": "{\"p\":\"dns\",\"op\":\"reg\",\"name\":\"jon.doge\",\"content\":\"gm\"}"
        },
        {
          "op": "move",
          "h": 120,
          "to": "A"
        }
      ],
      "expect": {
        "name": "jon.doge",
        "owner": "A",
        "records": {
          "content": "gm"
        }
      }
    },
    {
      "id": "burn-resets-records",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 1,
          "owner": "A",
          "body": "{\"p\":\"dns\",\"op\":\"reg\",\"name\":\"jon.doge\",\"address\":\"D8mZsgKwmSQWYRPEMCcm8KzNFj1JVF5UpA\"}"
        },
        {
          "op": "move",
          "h": 120,
          "to": null
        }
      ],
      "expect": {
        "name": "jon.doge",
        "owner": null,
        "records": {},
        "taken": true
      }
    },
    {
      "id": "buyer-config-in-the-transfer-sticks",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 1,
          "owner": "A",
          "body": "jon.doge"
        },
        {
          "op": "config",
          "h": 110,
          "tx": 3,
          "owner": "A",
          "body": "{\"p\":\"dns\",\"op\":\"config\",\"name\":\"jon.doge\",\"content\":\"seller\"}"
        },
        {
          "op": "move",
          "h": 120,
          "to": "B"
        },
        {
          "op": "config",
          "h": 120,
          "owner": "B",
          "sameTxAsMove": true,
          "body": "{\"p\":\"dns\",\"op\":\"config\",\"name\":\"jon.doge\",\"url\":\"https://dogecoin.dog\"}"
        }
      ],
      "expect": {
        "name": "jon.doge",
        "owner": "B",
        "records": {
          "url": "https://dogecoin.dog"
        },
        "configured": true
      },
      "reason": "The reset is applied with the spend. The buyer's config in that transaction is their first one; the seller's content does not come back."
    },
    {
      "id": "seller-config-after-sale-ignored",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 1,
          "owner": "A",
          "body": "jon.doge"
        },
        {
          "op": "move",
          "h": 120,
          "to": "B"
        },
        {
          "op": "config",
          "h": 121,
          "tx": 2,
          "owner": "A",
          "body": "{\"p\":\"dns\",\"op\":\"config\",\"name\":\"jon.doge\",\"address\":\"D8mZsgKwmSQWYRPEMCcm8KzNFj1JVF5UpA\"}"
        }
      ],
      "expect": {
        "name": "jon.doge",
        "owner": "B",
        "records": {}
      }
    },
    {
      "id": "replay-committed-reveal-wins",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 5,
          "owner": "B",
          "body": "carol.doge"
        },
        {
          "op": "register",
          "h": 110,
          "tx": 1,
          "owner": "A",
          "body": "carol.doge",
          "commit": {
            "h": 99,
            "tx": 2,
            "vout": 0
          },
          "committed": true
        }
      ],
      "expect": {
        "name": "carol.doge",
        "owner": "A",
        "missedClaims": 1
      },
      "reason": "A's commit (99) out-ranks B's reveal (100) inside W = 30. A replay keeps the last 30 blocks of P2SH outputs and agrees with a live indexer (\u00a75.7)."
    },
    {
      "id": "replay-classic-reveal-ranks-by-reveal",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 5,
          "owner": "B",
          "body": "carol.doge"
        },
        {
          "op": "register",
          "h": 110,
          "tx": 1,
          "owner": "A",
          "body": "carol.doge",
          "commit": {
            "h": 99,
            "tx": 2,
            "vout": 0
          },
          "committed": false
        }
      ],
      "expect": {
        "name": "carol.doge",
        "owner": "B",
        "missedClaims": 1
      },
      "reason": "Without the committed redeem a reveal ranks by its reveal."
    },
    {
      "id": "slow-committed-reveal-ranks-by-reveal",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 5,
          "owner": "B",
          "body": "carol.doge"
        },
        {
          "op": "register",
          "h": 131,
          "tx": 1,
          "owner": "A",
          "body": "carol.doge",
          "commit": {
            "h": 99,
            "tx": 2,
            "vout": 0
          },
          "committed": true
        }
      ],
      "expect": {
        "name": "carol.doge",
        "owner": "B",
        "missedClaims": 1
      },
      "reason": "131 - 99 = 32 > W, so A ranks by its reveal. By then B is final anyway."
    },
    {
      "id": "replay-bitwork-void",
      "steps": [
        {
          "op": "register",
          "h": 100,
          "tx": 1,
          "owner": "A",
          "revealTxid": "1111111111111111111111111111111111111111111111111111111111111111",
          "body": "{\"p\":\"dns\",\"op\":\"reg\",\"name\":\"erin.doge\",\"bitworkr\":\"0000000000\"}"
        }
      ],
      "expect": {
        "name": "erin.doge",
        "taken": false,
        "missedClaims": 0
      },
      "reason": "A failed bitwork claim is void in a replay as at the tip. It is not a missed claim."
    }
  ]
}
